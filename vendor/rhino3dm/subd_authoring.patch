diff --git a/src/bindings/bnd_subd.h b/src/bindings/bnd_subd.h
index 4978fad..d840583 100644
--- a/src/bindings/bnd_subd.h
+++ b/src/bindings/bnd_subd.h
@@ -211,6 +211,28 @@ public:
 
   const ON_SubD* GetONSubDComponent() const { return m_subd; }
 
+  // AUTHORING. ON_SubD can be built up vertex by vertex and face by face;
+  // none of it was reachable from a script, so a SubD could be READ from a
+  // .3dm and never written into one. Vertices are addressed by the index
+  // this object handed out, faces by their vertex indices (edges are found
+  // or made as the faces need them), and creases and sharpness by the two
+  // vertices of the edge. Call updateUnsetTagsAndSectorCoefficients() once
+  // the net is complete: it tags the naked edges as creases and every
+  // vertex from the edges meeting there, and leaves the tags set here alone.
+  int AddVertex(ON_3dPoint point);
+  int AddFace4(int v0, int v1, int v2, int v3);
+#if defined(ON_WASM_COMPILE)
+  int AddFace(emscripten::val vertexIndices);
+#endif
+  bool SetEdgeCrease(int v0, int v1, bool crease);
+  bool SetEdgeSharpness(int v0, int v1, double sharpness);
+  unsigned int UpdateUnsetTagsAndSectorCoefficients() { return m_subd->UpdateAllTagsAndSectorCoefficients(true); }
+  bool IsValid() const { return m_subd->IsValid(); }
+
 protected:
   void SetTrackedPointer(ON_SubD* subd, const ON_ModelComponentReference* compref);
+
+private:
+  std::vector<ON_SubDVertex*> m_authored_vertices;
+  int AddFaceFromVertexIndices(const int* vi, unsigned int n);
 };
