+  // AUTHORING. ON_Brep is fully capable of being built up; none of it was
+  // reachable from JS, which is what blocked writing a trimmed face to .3dm.
+  // Everything here COPIES its input before handing it to the brep, because
+  // ON_Brep::AddSurface/AddEdgeCurve/AddTrimCurve take ownership and a
+  // script-side object must not be freed out from under its owner.
+  // Indices are returned rather than references so the caller can wire the
+  // topology up by index, which is the only shape that survives embind.
+  int AddSurface(const class BND_Surface* surface);
+  int AddEdgeCurve(const class BND_Curve* curve);
+  int AddTrimCurve(const class BND_Curve* curve);
+  int NewVertex(ON_3dPoint point, double tolerance);
+  int NewEdge(int vertex0, int vertex1, int curve3dIndex, double tolerance);
+  int NewFace(int surfaceIndex);
+  int NewLoop(int faceIndex, int loopType);
+  int NewTrim(int loopIndex, int edgeIndex, bool reversed, int curve2dIndex, double tolerance);
+  int NewSingularTrim(int loopIndex, int vertexIndex, int isoType, int curve2dIndex, double tolerance);
+  bool SetTrimIsoFlags();
+  bool SetVertexTolerances(bool lazy);
+  bool SetEdgeTolerances(bool lazy);
+  bool SetTrimTolerances(bool lazy);
+  void Compact();
+  // NOTE: there is deliberately no join here. ON_Brep has none — JoinEdges
+  // appears only in comments in this opennurbs; Rhino's join lives above the
+  // library. It is not needed: a multi-face solid is authored as ONE brep
+  // whose faces already SHARE their edges, which is the state our own sewn
+  // solid is already in.
